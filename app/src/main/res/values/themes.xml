<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Focusmaxxing" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#3DFF88</item>
        <item name="android:windowBackground">#0B0D10</item>
        <item name="android:statusBarColor">#0B0D10</item>
        <item name="android:navigationBarColor">#0B0D10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Focusmaxxing.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0D10</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_paw</item>
        <item name="postSplashScreenTheme">@style/Theme.Focusmaxxing</item>
    </style>
</resources>
